(ns chassis-cowboy.handler
  (:require [dev.onionpancakes.chassis.core :as chassis]))

(def features
  [{:eyebrow "Render"
    :title "Immutable views"
    :copy "Build HTML from persistent vectors, maps, sequences, and reusable Clojerl functions."
    :accent "from-cyan-400 to-blue-500"}
   {:eyebrow "Serve"
    :title "Cowboy HTTP"
    :copy "Send Chassis output as an Erlang binary through Cowboy's production HTTP stack."
    :accent "from-violet-400 to-fuchsia-500"}
   {:eyebrow "Run"
    :title "OTP 28"
    :copy "Keep Clojure's data model while using BEAM supervision, processes, and fault isolation."
    :accent "from-emerald-400 to-teal-500"}])

(defn feature-card [{:keys [eyebrow title copy accent]}]
  [:article {:class "group relative overflow-hidden rounded-3xl border border-white/10 bg-white/[0.04] p-6 shadow-2xl shadow-black/20 backdrop-blur transition hover:-translate-y-1 hover:border-white/20"}
   [:div {:class (str "absolute inset-x-0 top-0 h-px bg-gradient-to-r " accent)}]
   [:p {:class "text-xs font-semibold uppercase tracking-[0.24em] text-cyan-300"} eyebrow]
   [:h2 {:class "mt-4 text-xl font-semibold text-white"} title]
   [:p {:class "mt-3 leading-7 text-slate-400"} copy]])

(defn page []
  [chassis/doctype-html5
   [:html {:lang "en"}
    [:head
     [:meta {:charset "utf-8"}]
     [:meta {:name "viewport" :content "width=device-width, initial-scale=1"}]
     [:meta {:name "description"
             :content "A Clojerl 0.9.1 Cowboy application rendered with Chassis."}]
     [:title "Chassis on the BEAM"]
     [:script {:src "https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"}]]
    [:body {:class "min-h-screen overflow-x-hidden bg-slate-950 text-slate-100 antialiased selection:bg-cyan-300 selection:text-slate-950"}
     [:div {:class "pointer-events-none fixed inset-0"
            :aria-hidden true}
      [:div {:class "absolute left-1/2 top-[-18rem] h-[36rem] w-[54rem] -translate-x-1/2 rounded-full bg-cyan-500/15 blur-3xl"}]
      [:div {:class "absolute bottom-[-20rem] right-[-12rem] h-[34rem] w-[34rem] rounded-full bg-violet-500/10 blur-3xl"}]]

     [:main {:class "relative mx-auto flex min-h-screen max-w-6xl flex-col px-6 py-8 lg:px-8"}
      [:nav {:class "flex items-center justify-between"}
       [:a {:href "/" :class "flex items-center gap-3 font-semibold tracking-tight text-white"}
        [:span {:class "grid size-10 place-items-center rounded-2xl bg-gradient-to-br from-cyan-300 to-blue-600 text-sm font-black text-slate-950 shadow-lg shadow-cyan-500/20"} "CH"]
        [:span "Chassis"]]
       [:div {:class "flex items-center gap-2 rounded-full border border-emerald-300/20 bg-emerald-300/10 px-4 py-2 text-xs font-medium text-emerald-200"}
        [:span {:class "size-2 rounded-full bg-emerald-300 shadow-[0_0_14px_rgba(110,231,183,0.8)]"}]
        "OTP 28 ready"]]

      [:section {:class "grid flex-1 items-center gap-14 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-28"}
       [:div
        [:div {:class "inline-flex items-center gap-2 rounded-full border border-cyan-300/20 bg-cyan-300/10 px-4 py-2 text-sm text-cyan-100"}
         [:span {:class "font-semibold"} "Clojerl 0.9.1"]
         [:span {:class "text-cyan-300/50"} "/"]
         [:span "Cowboy 2.13"]]
        [:h1 {:class "mt-8 max-w-3xl text-5xl font-black leading-[0.98] tracking-[-0.05em] text-white sm:text-7xl"}
         "HTML as data, "
         [:span {:class "bg-gradient-to-r from-cyan-300 via-blue-400 to-violet-400 bg-clip-text text-transparent"}
          "running on the BEAM."]]
        [:p {:class "mt-7 max-w-2xl text-lg leading-8 text-slate-400 sm:text-xl"}
         "Chassis turns Clojerl vectors into escaped HTML. Cowboy delivers the response. OTP keeps the service alive."]
        [:div {:class "mt-10 flex flex-wrap gap-4"}
         [:a {:href "https://github.com/antlobach/chassis-clojerl"
              :class "rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-slate-950 shadow-xl shadow-white/10 transition hover:bg-cyan-100"}
          "View Chassis"]
         [:a {:href "https://github.com/antlobach/clojerl"
              :class "rounded-2xl border border-white/15 bg-white/5 px-5 py-3 text-sm font-semibold text-white transition hover:border-cyan-300/40 hover:bg-cyan-300/10"}
          "Explore Clojerl"]]]

       [:aside {:class "relative"}
        [:div {:class "absolute -inset-6 rounded-[2.5rem] bg-gradient-to-br from-cyan-500/20 to-violet-500/20 blur-2xl"}]
        [:div {:class "relative overflow-hidden rounded-[2rem] border border-white/10 bg-slate-900/90 shadow-2xl shadow-black/40"}
         [:div {:class "flex items-center gap-2 border-b border-white/10 px-5 py-4"}
          [:span {:class "size-2.5 rounded-full bg-rose-400"}]
          [:span {:class "size-2.5 rounded-full bg-amber-300"}]
          [:span {:class "size-2.5 rounded-full bg-emerald-400"}]
          [:span {:class "ml-3 text-xs text-slate-500"} "clje.user"]]
         [:pre {:class "overflow-x-auto p-6 text-sm leading-7 text-slate-300"}
          [:code
           [:span {:class "text-violet-300"} "(require"]
           " '[dev.onionpancakes.chassis.core :as c])\n\n"
           [:span {:class "text-violet-300"} "(c/html"]
           " [:h1.text-cyan-300 \"Hello, BEAM\"])\n\n"
           [:span {:class "text-emerald-300"} "\"<h1 class=\\\"text-cyan-300\\\">Hello, BEAM</h1>\""]]]]]]

      [:section {:class "grid gap-5 pb-14 md:grid-cols-3"}
       (map feature-card features)]

      [:footer {:class "flex flex-col gap-2 border-t border-white/10 py-7 text-sm text-slate-500 sm:flex-row sm:items-center sm:justify-between"}
       [:p "Rendered by Chassis. Served by Cowboy."]
       [:p "Clojerl 0.9.1 on Erlang/OTP 28"]]]]]])

(defn init [request state]
  (let [body (chassis/html (page))
        headers #erl{"content-type" "text/html; charset=utf-8"}
        response (#erl cowboy_req/reply 200 headers body request)]
    #erl[:ok response state]))
